#!/bin/sh
# 推送前自动检查（docs/归档/07-代码管理与发布.md）：iOS 日常检查都通过才推上去，坏了的代码不会到 GitHub。
# 不要用 --no-verify 跳过。只改了文档（docs/ 和根目录的 .md）时只跑不开模拟器的那几项，省几分钟。
# 日志写在 Git 自己的目录里：普通的克隆是 .git/；git worktree 里 .git 是个文件，要问 Git 真正的目录在哪
GIT_DIR_REAL="$(git rev-parse --git-dir)"
LOG="${GIT_DIR_REAL}/pre-push.log"

MODE=""
BASE="$(git merge-base HEAD origin/main 2>/dev/null || true)"
if [ -n "${BASE}" ] && [ -z "$(git diff --name-only "${BASE}" HEAD | grep -vE '^docs/|^[^/]+\.md$')" ]; then
  MODE="--no-ui"
fi

echo ""
if [ -n "${MODE}" ]; then
  echo "  推送前检查：只改了文档，跑密钥、格式、规范、单元测试（约 1 分钟）……"
else
  echo "  推送前检查：密钥、格式、规范、依赖方向、单元、两个系统的界面测试和审计（约 5–8 分钟）……"
fi
if ! scripts/check.sh ${MODE} >"${LOG}" 2>&1; then
  echo ""
  echo "  检查没通过，这次没有推送："
  grep -E "✗|error:" "${LOG}" | head -20
  echo ""
  echo "  完整输出在 ${LOG}。修好后再推。"
  exit 1
fi
echo "  检查通过，开始推送。"
exit 0
